generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

// Named BranchCode because the Branch model below holds the reference data.
enum BranchCode {
  EXPERIENCE
  MINISTRY
  CREATIVE
  SYSTEMS
}

enum BlockType {
  HEADING
  TEXT
  IMAGE
  VIDEO
  FLIP_CARDS
  ACCORDION
  TABS
  TIMELINE
  PYRAMID
  PEOPLE
  REFLECTION
  CHECKLIST
  CONTACT
  LINK_QR
  KNOWLEDGE_CHECK
  NARRATOR_CALLOUT
}

enum LeaderGroup {
  CHURCH_FAMILY
  BRANCH_LEAD
  TEAM_LEAD
}

// ─── Volunteers ──────────────────────────────────────────────────────────────

/// One per Supabase auth user; id is the auth.users id (set by the app, no default).
model Profile {
  id             String      @id @db.Uuid
  email          String      @unique
  firstName      String
  lastName       String
  branchInterest BranchCode?
  teamInterest   String?
  consentAt      DateTime
  hideNarrator   Boolean     @default(false)
  /// Reminder emails after a week without progress (unsubscribe turns it off).
  emailReminders Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  moduleProgress    ModuleProgress[]
  quizAttempts      QuizAttempt[]
  certificates      Certificate[]
  reflectionAnswers ReflectionAnswer[]
  emailLogs         EmailLog[]
}

// ─── Course content ──────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  description String
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules       Module[]
  quizQuestions QuizQuestion[]
  quizSections  QuizSection[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]

  @@index([isPublished, order])
}

model Module {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String   @db.Uuid
  slug          String
  title         String
  summary       String
  order         Int      @default(0)
  isPublished   Boolean  @default(false)
  narratorIntro String?
  /// Volunteers must pass this module's knowledge check to complete it.
  requiresCheck Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  blocks            Block[]
  progress          ModuleProgress[]
  reflectionAnswers ReflectionAnswer[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Block {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId     String    @db.Uuid
  order        Int       @default(0)
  type         BlockType
  /// Shape depends on type; validated with zod in the app.
  content      Json
  /// Volunteers only see content where isPublished. Admin edits go to the
  /// draft fields until "Publish changes" copies them over.
  isPublished  Boolean   @default(true)
  /// Unpublished edit of content (same shape, validated the same way).
  draftContent Json?
  /// Removed in the editor; deleted when the module's changes are published.
  draftDeleted Boolean   @default(false)
  /// Unpublished position; replaces order when published.
  draftOrder   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  module            Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  reflectionAnswers ReflectionAnswer[]

  // Not unique, so blocks can be reordered without constraint juggling.
  @@index([moduleId, order])
}

// ─── Progress, quiz and certificates ─────────────────────────────────────────

model ModuleProgress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String    @db.Uuid
  moduleId       String    @db.Uuid
  lastBlockOrder Int       @default(0)
  checkPassed    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([profileId, moduleId])
  @@index([moduleId])
}

/// A volunteer's answer to a REFLECTION block's prompt.
model ReflectionAnswer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @db.Uuid
  /// Null if the block is later deleted; prompt keeps the question.
  blockId   String?  @db.Uuid
  moduleId  String   @db.Uuid
  /// The question as it was when answered.
  prompt    String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([profileId, blockId])
  @@index([blockId])
  @@index([moduleId])
}

model QuizQuestion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String   @db.Uuid
  /// Id from the question bank JSON, e.g. "Q01".
  externalId      String?
  /// QuizSection.topic, e.g. "about-kc".
  topic           String
  /// Questions in the same group test the same fact; an attempt draws one.
  group           String?
  prompt          String
  /// Array of { id: string, text: string }.
  options         Json
  correctOptionId String
  explanation     String
  /// Always included in every attempt.
  isRequired      Boolean  @default(false)
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, externalId])
  @@index([courseId, isActive, order])
}

/// A topic in the question bank, e.g. { topic: "about-kc", title: "About KC" }.
model QuizSection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String   @db.Uuid
  topic     String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, topic])
}

model QuizAttempt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @db.Uuid
  courseId    String    @db.Uuid
  /// Question ids drawn for this attempt, in the order shown.
  questionIds Json
  /// Map of questionId → option ids in the order shown.
  optionOrder Json      @default("{}")
  /// Map of questionId → chosen optionId. Empty until submitted.
  answers     Json      @default("{}")
  /// Null until submitted.
  score       Int?
  total       Int
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  /// Null while the attempt is in progress.
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([profileId, courseId])
  @@index([profileId, courseId, submittedAt])
  @@index([courseId])
}

model Certificate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String   @db.Uuid
  courseId          String   @db.Uuid
  /// Human readable, e.g. KC-2026-000123.
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  // Restrict: a course with issued certificates can't be deleted by accident.
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([profileId, courseId])
  @@index([courseId])
}

// ─── Reference data ──────────────────────────────────────────────────────────

model Branch {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        BranchCode @unique
  name        String
  description String
  /// Hex colour, e.g. #FF5FC8.
  colour      String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teams   Team[]
  leaders Leader[]
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @db.Uuid
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, order])
}

model Leader {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  role      String
  photoUrl  String?
  branchId  String?     @db.Uuid
  group     LeaderGroup
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([group, order])
  @@index([branchId])
}

/// Key/value settings: safeguarding contacts, incident form URL, WhatsApp
/// group URL, quiz pass mark, questions per attempt.
model SiteSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Admin ───────────────────────────────────────────────────────────────────

/// Append-only change log for the admin editor.
model ContentChange {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity    String
  entityId  String
  /// e.g. create, update, delete, publish, reorder.
  action    String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Used to rate-limit the shared admin password.
model AdminLoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipHash    String
  succeeded Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ipHash, createdAt])
}

/// One row per magic-link request, for per-email rate limiting.
/// Stores an HMAC of the email, never the address itself.
model SignInAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailHash, createdAt])
  @@index([createdAt])
}

// ─── Email ───────────────────────────────────────────────────────────────────

enum EmailStatus {
  SENT
  FAILED
  /// Not sent: no RESEND_API_KEY (the email was printed to the console).
  SKIPPED
}

/// Every transactional email the app tried to send (src/server/email.ts).
model EmailLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The volunteer it was for, when there is one.
  profileId String?     @db.Uuid
  /// The intended recipient (before any EMAIL_REDIRECT_TO in development).
  to        String
  template  String
  status    EmailStatus
  resendId  String?
  error     String?
  createdAt DateTime    @default(now())

  // Logs hold an email address, so they go with the volunteer's account.
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

// ─── Media ───────────────────────────────────────────────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
  CAPTIONS
}

/// A file uploaded to the public "course-media" Storage bucket.
model Media {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      MediaKind
  /// Public URL, as stored in blocks and leaders.
  url       String    @unique
  /// Object path in the bucket: {yyyy}/{mm}/{uuid}-{safe-filename}.
  path      String    @unique
  filename  String
  mimeType  String
  /// Bytes.
  size      Int
  /// Required for images.
  altText   String?
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind, createdAt])
}
