generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Placeholder model used by GET /api/health. The real data model lands in Phase 3.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
