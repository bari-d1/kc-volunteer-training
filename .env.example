# Supabase Postgres — find both under Connect > Connection String in the Supabase dashboard.
# URL-encode special characters in the password (e.g. / becomes %2F).

# App runtime: transaction pooler (Supavisor), port 6543.
# pgbouncer=true and connection_limit=1 keep serverless functions from exhausting the pool.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations and Prisma Studio: session pooler, port 5432. (The "Direct connection"
# string also works, but only on networks with IPv6.)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API: Project Settings > API Keys. Used for auth and scripts/check-rls.mts.
# The publishable key is safe in the browser; RLS keeps it out of our tables.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[PUBLISHABLE_KEY]"

# Public site URL: absolute links in social previews and magic-link emails.
# Falls back to the Vercel production URL, then http://localhost:3000.
SITE_URL="https://volunteers.example.com"

# Secret used to hash emails for sign-in rate limiting. Any long random string.
AUTH_RATE_LIMIT_SECRET="[RANDOM_STRING]"

# Shared admin password for /admin (temporary; replaced by admin accounts later).
# Generate the hash with: pnpm admin:hash-password
# Paste the printed line here. Never store the plain password.
ADMIN_PASSWORD_HASH="[OUTPUT_OF_pnpm_admin:hash-password]"

# Signs the admin session cookie. At least 32 random characters, e.g.
#   openssl rand -base64 32
# Changing it signs every admin out.
ADMIN_SESSION_SECRET="[RANDOM_32_PLUS_CHARS]"

# Supabase secret key (Project Settings > API Keys > Secret keys; the legacy
# service_role key also works). Used only on the server to delete a volunteer's
# login when they delete their account. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="[SECRET_KEY]"

# Only for `pnpm auth:configure` (Supabase Auth settings via the Management API).
# Personal access token: https://supabase.com/dashboard/account/tokens
# It can manage every project on your account: keep it out of git and hosting env vars.
SUPABASE_ACCESS_TOKEN="[PERSONAL_ACCESS_TOKEN]"
# Project ref (the subdomain of NEXT_PUBLIC_SUPABASE_URL). Optional: derived from that URL if unset.
SUPABASE_PROJECT_REF="[PROJECT_REF]"
